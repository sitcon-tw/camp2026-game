digraph LittleStoneEvolution {
  graph [
    rankdir=LR,
    splines=true,
    nodesep=0.55,
    ranksep=1.15,
    pad=0.3,
    bgcolor="white",
    pack=true,
    packmode="array_u6",
    forcelabels=true
  ];

  node [
    shape=plain,
    fontname="Noto Sans CJK TC",
    fontsize=12
  ];

  edge [
    fontname="Noto Sans CJK TC",
    fontsize=11,
    fontcolor="#4a5568",
    decorate=true
  ];
  // =========================
  // 活動限定小石
  // =========================
  subgraph cluster_event_limited {
    label="活動限定小石";
    color="#cccccc";
    style="rounded";

    stone_python_turtle [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_python_turtle.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>烏龜小石</TD></TR>
      </TABLE>>
    ];
    stone_fireside [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_fireside.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>爐邊小石</TD></TR>
      </TABLE>>
    ];

    stone_command_blind_trip [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_command_blind_trip.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>指令盲旅小石</TD></TR>
      </TABLE>>
    ];
    stone_human_llm [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_human_llm.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>人類大語言模型小石</TD></TR>
      </TABLE>>
    ];
    stone_von_neumann [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_von_neumann.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>馮紐曼小石</TD></TR>
      </TABLE>>
    ];
    stone_packet_rescue [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_packet_rescue.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>封包救援小石</TD></TR>
      </TABLE>>
    ];
    stone_prompt_injection [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_prompt_injection.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>Prompt Injection 小石</TD></TR>
      </TABLE>>
    ];

    stone_python_turtle -> stone_fireside [style=invis, weight=10];
    stone_fireside -> stone_command_blind_trip [style=invis, weight=10];
    stone_command_blind_trip -> stone_human_llm [style=invis, weight=10];
    stone_human_llm -> stone_von_neumann [style=invis, weight=10];
    stone_von_neumann -> stone_packet_rescue [style=invis, weight=10];
    stone_packet_rescue -> stone_prompt_injection [style=invis, weight=10];
  }

  // =========================
  // 探索型小石
  // =========================
  subgraph cluster_explore {
    label="探索型小石";
    color="#cccccc";
    style="rounded";

    basic_gray [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/basic_gray.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>探索型小石</TD></TR>
      </TABLE>>
    ];

    stone_2022_maze [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2022_maze.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2022 迷宮小石</TD></TR>
      </TABLE>>
    ];
    stone_2022_break_wall_cat [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2022_break_wall_cat.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2022 破牆貓小石</TD></TR>
      </TABLE>>
    ];

    stone_camp_backpack [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_camp_backpack.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>營地背包小石</TD></TR>
      </TABLE>>
    ];
    stone_2026_camp_explorer [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2026_camp_explorer.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2026 營地探險小石</TD></TR>
      </TABLE>>
    ];

    stone_booth [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_booth.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>攤位小石</TD></TR>
      </TABLE>>
    ];
    stone_star_village_guide [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_star_village_guide.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>星手村嚮導小石</TD></TR>
      </TABLE>>
    ];

    stone_2019_blackbox [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2019_blackbox.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2019 黑箱小石</TD></TR>
      </TABLE>>
    ];
    stone_2019_unboxed_algorithm [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2019_unboxed_algorithm.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2019 開箱演算法小石</TD></TR>
      </TABLE>>
    ];

    item_label_01 [label="道具：迷宮地圖", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_gray -> item_label_01 [arrowhead=none];

    item_label_01 -> stone_2022_maze;
    item_label_02 [label="道具：貓掌印", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_2022_maze -> item_label_02 [arrowhead=none];
    item_label_02 -> stone_2022_break_wall_cat;

    item_label_03 [label="道具：冒險背包", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_gray -> item_label_03 [arrowhead=none];

    item_label_03 -> stone_camp_backpack;
    item_label_04 [label="道具：任務地圖", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_camp_backpack -> item_label_04 [arrowhead=none];
    item_label_04 -> stone_2026_camp_explorer;

    item_label_05 [label="道具：攤位貼紙", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_gray -> item_label_05 [arrowhead=none];

    item_label_05 -> stone_booth;
    item_label_06 [label="道具：星手村路標", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_booth -> item_label_06 [arrowhead=none];
    item_label_06 -> stone_star_village_guide;

    item_label_07 [label="道具：黑箱貼紙", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_gray -> item_label_07 [arrowhead=none];

    item_label_07 -> stone_2019_blackbox;
    item_label_08 [label="道具：工具箱鑰匙", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_2019_blackbox -> item_label_08 [arrowhead=none];
    item_label_08 -> stone_2019_unboxed_algorithm;

    {
      rank=same;
      stone_2022_maze;
      stone_camp_backpack;
      stone_booth;
      stone_2019_blackbox;
    }
    {
      rank=same;
      stone_2022_break_wall_cat;
      stone_2026_camp_explorer;
      stone_star_village_guide;
      stone_2019_unboxed_algorithm;
    }
  }

  // =========================
  // 靈光型小石
  // =========================
  subgraph cluster_inspiration {
    label="靈光型小石";
    color="#cccccc";
    style="rounded";

    basic_yellow [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/basic_yellow.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>靈光型小石</TD></TR>
      </TABLE>>
    ];

    stone_2021_abacus [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2021_abacus.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2021 算盤小石</TD></TR>
      </TABLE>>
    ];
    stone_2021_abacus_descendant [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2021_abacus_descendant.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2021 算盤後裔小石</TD></TR>
      </TABLE>>
    ];

    stone_prompt [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_prompt.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>Prompt 小石</TD></TR>
      </TABLE>>
    ];
    stone_human_after_all [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_human_after_all.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>Human After All 小石</TD></TR>
      </TABLE>>
    ];

    stone_sticky_note [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_sticky_note.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>便利貼小石</TD></TR>
      </TABLE>>
    ];
    stone_course_shared_notes [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_course_shared_notes.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>課程共筆小石</TD></TR>
      </TABLE>>
    ];

    stone_2024_finite [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2024_finite.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2024 有限小石</TD></TR>
      </TABLE>>
    ];
    stone_2024_infinite_inspiration [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2024_infinite_inspiration.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2024 無限靈感小石</TD></TR>
      </TABLE>>
    ];

    item_label_09 [label="道具：木製算珠", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_yellow -> item_label_09 [arrowhead=none];

    item_label_09 -> stone_2021_abacus;
    item_label_10 [label="道具：前人筆記", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_2021_abacus -> item_label_10 [arrowhead=none];
    item_label_10 -> stone_2021_abacus_descendant;

    item_label_11 [label="道具：Prompt 卡", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_yellow -> item_label_11 [arrowhead=none];

    item_label_11 -> stone_prompt;
    item_label_12 [label="道具：人類標籤", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_prompt -> item_label_12 [arrowhead=none];
    item_label_12 -> stone_human_after_all;

    item_label_13 [label="道具：便利貼", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_yellow -> item_label_13 [arrowhead=none];

    item_label_13 -> stone_sticky_note;
    item_label_14 [label="道具：共筆連結", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_sticky_note -> item_label_14 [arrowhead=none];
    item_label_14 -> stone_course_shared_notes;

    item_label_15 [label="道具：有限標籤", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_yellow -> item_label_15 [arrowhead=none];

    item_label_15 -> stone_2024_finite;
    item_label_16 [label="道具：無限星圖", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_2024_finite -> item_label_16 [arrowhead=none];
    item_label_16 -> stone_2024_infinite_inspiration;

    {
      rank=same;
      stone_2021_abacus;
      stone_prompt;
      stone_sticky_note;
      stone_2024_finite;
    }
    {
      rank=same;
      stone_2021_abacus_descendant;
      stone_human_after_all;
      stone_course_shared_notes;
      stone_2024_infinite_inspiration;
    }
  }

  // =========================
  // 共鳴型小石
  // =========================
  subgraph cluster_resonance {
    label="共鳴型小石";
    color="#cccccc";
    style="rounded";

    basic_purple [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/basic_purple.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>共鳴型小石</TD></TR>
      </TABLE>>
    ];

    stone_community_handshake [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_community_handshake.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>社群握手小石</TD></TR>
      </TABLE>>
    ];
    stone_star_village_exchange [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_star_village_exchange.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>星手村交流小石</TD></TR>
      </TABLE>>
    ];

    stone_consensus_draft [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_consensus_draft.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>共識草稿小石</TD></TR>
      </TABLE>>
    ];
    stone_student_autonomy [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_student_autonomy.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>學生自治小石</TD></TR>
      </TABLE>>
    ];

    stone_contribution [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_contribution.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>貢獻小石</TD></TR>
      </TABLE>>
    ];
    stone_open_source_route [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_open_source_route.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>Open Source 路線小石</TD></TR>
      </TABLE>>
    ];

    stone_2020_tour_flag [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2020_tour_flag.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2020 導遊旗小石</TD></TR>
      </TABLE>>
    ];
    stone_2020_sitcon_tour_group [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_2020_sitcon_tour_group.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>2020 SITCON 導遊團小石</TD></TR>
      </TABLE>>
    ];

    item_label_17 [label="道具：學生社群卡", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_purple -> item_label_17 [arrowhead=none];

    item_label_17 -> stone_community_handshake;
    item_label_18 [label="道具：星手村徽章", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_community_handshake -> item_label_18 [arrowhead=none];
    item_label_18 -> stone_star_village_exchange;

    item_label_19 [label="道具：章程草稿", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_purple -> item_label_19 [arrowhead=none];

    item_label_19 -> stone_consensus_draft;
    item_label_20 [label="道具：透明提案", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_consensus_draft -> item_label_20 [arrowhead=none];
    item_label_20 -> stone_student_autonomy;

    item_label_21 [label="道具：貢獻貼紙", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_purple -> item_label_21 [arrowhead=none];

    item_label_21 -> stone_contribution;
    item_label_22 [label="道具：開源路線圖", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_contribution -> item_label_22 [arrowhead=none];
    item_label_22 -> stone_open_source_route;

    item_label_23 [label="道具：導遊旗", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];

    basic_purple -> item_label_23 [arrowhead=none];

    item_label_23 -> stone_2020_tour_flag;
    item_label_24 [label="道具：會場路線", shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e0", fontcolor="#4a5568", margin="0.05,0.03"];
    stone_2020_tour_flag -> item_label_24 [arrowhead=none];
    item_label_24 -> stone_2020_sitcon_tour_group;

    {
      rank=same;
      stone_community_handshake;
      stone_consensus_draft;
      stone_contribution;
      stone_2020_tour_flag;
    }
    {
      rank=same;
      stone_star_village_exchange;
      stone_student_autonomy;
      stone_open_source_route;
      stone_2020_sitcon_tour_group;
    }
  }

  // =========================
  // 工程型小石
  // =========================
  subgraph cluster_engineering {
    label="工程型小石";
    color="#cccccc";
    style="rounded";

    basic_blue [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/basic_blue.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>工程型小石</TD></TR>
      </TABLE>>
    ];

    stone_docker [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_docker.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>Docker 小石</TD></TR>
      </TABLE>>
    ];
    stone_kubernetes [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD FIXEDSIZE="TRUE" WIDTH="92" HEIGHT="92"><IMG SRC="../frontend/public/game-icons/stones/stone_kubernetes.png" SCALE="TRUE"/></TD></TR>
        <TR><TD>Kubernetes 小石</TD></TR>
      </TABLE>>
